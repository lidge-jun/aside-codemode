node_modules/
# Machine-specific: roots and rgPath differ per host (Windows vs macOS paths,
# vendored rg.exe vs Homebrew rg). Generated by scripts/register-aside.mjs.
# Committing it made a fresh clone crash on the other OS. Ship the example instead.
codemode.config.json

# Local records stay local. This repository is public, and these three trees are where a
# machine describes itself: hostnames, account names, home directories, node paths, session
# ids and per-host install manifests. None of it helps anyone reading the project, and a
# fleet note naming four machines and three usernames is not a release artifact.
devlog/
.codexclaw/

# evidence/ is kept out by default for the same reason: probe dumps and per-host install
# records are written here. The exceptions are the measurement notes the README cites and the
# tests read, which carry numbers and no machine identity.
evidence/*
!evidence/aside-mcp-activation-260918.md
!evidence/aside-mcp-attach-260918.md
!evidence/browse-compression-260915.md
!evidence/dev-folder-51x.md
!evidence/exclude-pruning-260918.md
!evidence/synthetic-search-bench.md
!evidence/summary.md
!evidence/summary-compound.md
!evidence/review-hardening-20260913.json
